{
	"name": "grokdex",
	"version": "0.1.6",
	"description": "Use your ChatGPT plan in Grok Build",
	"keywords": [
		"grok",
		"grok-build",
		"chatgpt",
		"codex",
		"openai",
		"mcp"
	],
	"license": "Elastic-2.0",
	"author": "aarock1234",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aarock1234/grokdex.git"
	},
	"type": "module",
	"bin": {
		"grokdex": "dist/main.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "concurrently \"pnpm typecheck\" \"pnpm lint\" \"pnpm format:check\"",
		"clean": "rm -rf dist",
		"prepublishOnly": "pnpm check && pnpm build",
		"test": "vitest run"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"pino": "^10.4.0",
		"smol-toml": "^1.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"concurrently": "^10.0.6",
		"eslint": "^10.12.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4"
	}
}
